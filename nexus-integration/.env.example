# Copy file ini menjadi .env  ->  cp .env.example .env
# JANGAN commit .env yang berisi nilai asli ke git.

# ---- Image tiap service (hasil docker push tim masing-masing) ----
# Selama image tim belum siap, biarkan default (alpine = placeholder, container nyala tapi kosong).
AUTH_IMAGE=alpine
BIDDING_IMAGE=alpine
MATCH_IMAGE=alpine
AUDIT_IMAGE=scientivan/monitoring-scoring-tracker:latest
NOTIFY_IMAGE=alpine

# ---- RabbitMQ (infra bersama) ----
RABBIT_USER=guest
RABBIT_PASS=guest

# ---- Kredensial DB per service (boleh dibiarkan default untuk demo) ----
AUTH_DB_USER=auth
AUTH_DB_PASS=auth
AUTH_DB_NAME=auth

BIDDING_DB_USER=bidding
BIDDING_DB_PASS=bidding
BIDDING_DB_NAME=bidding

MATCH_DB_USER=match
MATCH_DB_PASS=match
MATCH_DB_NAME=match

AUDIT_DB_USER=kel4
AUDIT_DB_PASS=kel4
AUDIT_DB_NAME=kel4

NOTIFY_DB_USER=notify
NOTIFY_DB_PASS=notify
NOTIFY_DB_NAME=notify

# ---- Supabase (khusus service audit/tracker) ----
# PENTING: rotate key lama yang sempat ter-commit, lalu isi yang baru di sini.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
