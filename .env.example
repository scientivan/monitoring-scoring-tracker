DB_HOST=db
DB_PORT=5432
DB_USER=kel4
DB_PASSWORD=kel4
DB_NAME=kel4

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Bucket should be public if GET /documents/:id/download returns a direct public URL.
SUPABASE_STORAGE_BUCKET=documents

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=tracker.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_PREFIX=tracker
RABBITMQ_PUBLISH_RETRIES=3
RABBITMQ_PUBLISH_RETRY_DELAY_MS=200
REDIS_URL=redis://redis:6379
PROJECT_COMPLETION_LOCK_TTL_MS=10000
